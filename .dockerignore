# Environment files (use env vars at runtime)
.env
.env.*

# Git
.git
.gitignore

# IDE
.vscode
.idea

# Logs
*.log

# Docker files (no need to copy into the image)
Dockerfile
.dockerignore
docker-compose.yml

# Misc
.temp
.tmp
README.md

# Go build artifacts / local data (the root Dockerfile builds from api/src)
api/src/uploads
api/src/files
api/src/bin
api/src/coverage.out
api/src/*.test
