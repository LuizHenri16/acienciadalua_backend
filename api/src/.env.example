# ─── Banco de dados ───────────────────────────────────────────────────────────
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=acienciadalua
# O parâmetro ?schema=public é aceito (e removido pela API antes de conectar).
DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/acienciadalua?schema=public

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET="troque-por-um-segredo-aleatorio"
JWT_EXPIRES_IN=1h

JWT_REFRESH_SECRET="troque-por-outro-segredo-aleatorio"
JWT_REFRESH_EXPIRES_IN=7d

JWT_SECRET_CUSTOMER="troque-por-um-segredo-aleatorio"

# ─── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
# Usada pelos links dos e-mails (criação/redefinição de senha).
# Se ausente, a API usa APP_URL.
FRONTEND_URL=http://localhost:3002

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_SENDER_ADDRESS=contato@acienciadalua.com.br
CONTACT_EMAIL=acienciadalua@gmail.com

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# A URL do webhook precisa estar publica e ativa (ex.: ngrok http 3000).
MP_WEBHOOK_URL=https://seu-tunel-publico.ngrok-free.dev/payment/webhook
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxxxxxx

# URLs de retorno (publicas, nunca localhost)
MP_SUCCESS_URL=https://acienciadalua.com.br/pagamento/sucesso
MP_FAILURE_URL=https://acienciadalua.com.br/pagamento/erro
MP_PENDING_URL=https://acienciadalua.com.br/pagamento/pendente

# ─── Opcionais (Go) ───────────────────────────────────────────────────────────
# Sobrescreve as origens CORS (padrão: lista fixa do backend NestJS).
# CORS_ORIGINS=https://acienciadalua.com.br,http://localhost:3002
# Executa as migrations embutidas ao iniciar (padrão: true).
# RUN_MIGRATIONS=true
# Diretórios de upload/download (padrão: uploads e files no diretório atual).
# UPLOAD_DIR=uploads
# FILES_DIR=files
