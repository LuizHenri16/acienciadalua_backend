// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("collaborator")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ─── Vitrine / Produtos ───────────────────────────────────────────────────────

model Product {
  id          String      @id @default(uuid())
  title       String
  description String
  price       Decimal
  coverUrl    String
  fileUrl     String
  category    Category
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  purchases Purchase[]
}

enum Category {
  STUDENT
  TEACHER
}

// ─── Customers (Alunos / Professores) ────────────────────────────────────────

model Customer {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tokens    AuthToken[]
  purchases Purchase[]
}

// ─── Magic Link ───────────────────────────────────────────────────────────────

model AuthToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([token])
}

// ─── Compras ──────────────────────────────────────────────────────────────────

model Purchase {
  id                   String   @id @default(uuid())
  mercadoPagoPaymentId String   @unique
  amountPaid           Decimal
  purchasedAt          DateTime

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([productId])
}
